# Copy to .env and fill in. Never commit .env.

# --- Required -----------------------------------------------------------------------------------
# From @BotFather. Use a test bot during development.
BOT_TOKEN=
# Your numeric Telegram user ID (comma-separate several owners). Owners always receive translations
# and manage approvals. Find it via the bot's access-denied message or @userinfobot.
OWNER_IDS=

# At least one provider key:
# Google Gemini (free tier: https://aistudio.google.com/apikey). Handles slang, Hinglish, context, sticker text.
GEMINI_API_KEY=
# DeepL API Free (keys end in ":fx"; 1M chars/month). Used for clean standard text and as fallback.
DEEPL_API_KEY=

# --- Gemini models (verified against your key at startup; see /status) -------------------------
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_QUALITY_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_THINKING=MINIMAL
GEMINI_QUALITY_THINKING=LOW
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Local guards so the bot stays inside free-tier limits (check your limits at aistudio.google.com/rate-limit)
GEMINI_RPM=15
GEMINI_RPD=1000
# Ask Google not to store requests (sent as `store: false`)
GEMINI_STORE=false

# --- Behaviour ----------------------------------------------------------------------------------
DEFAULT_TARGET_LANG=en
# true = approved users receive nothing until they choose a language in private chat
ONBOARDING_REQUIRED=false
# who may use the inline translator: approved | everyone
INLINE_ACCESS=approved
# which newly joined groups are translated automatically: owner_added | all | none
ENABLE_NEW_GROUPS=owner_added
# rapid messages from one sender within this window are translated & delivered together (0 = off)
BURST_WINDOW_MS=700
CONTEXT_MESSAGES=6
CONTEXT_TTL_S=900
MAX_TEXT_CHARS=3000

# --- Media --------------------------------------------------------------------------------------
MEDIA_ENABLED=true
VISION_OCR=true
FFMPEG_PATH=ffmpeg
MAX_DOWNLOAD_BYTES=8388608
MAX_VIDEO_SECONDS=15
# videos, video notes and voice messages longer than this are skipped (speech translation)
MAX_MEDIA_SECONDS=60
MAX_VIDEO_BYTES=20971520
MAX_FRAMES=24
MEDIA_WORKERS=2
OCR_MIN_CONFIDENCE=0.6

# --- Throughput ---------------------------------------------------------------------------------
TEXT_WORKERS=4
QUEUE_MAX=500
PER_CHAT_QUEUE_MAX=40
EPHEMERAL_PER_CHAT_PER_MIN=60
GLOBAL_SENDS_PER_S=25
INLINE_PER_MIN=30
INLINE_TIMEOUT_S=4
PROVIDER_TIMEOUT_S=12

# --- Advanced (defaults are fine) ---------------------------------------------------------------
# DeepL Free allows 1,000,000 chars/month; stop a little earlier so a month never ends on errors
# DEEPL_MONTHLY_CHAR_BUDGET=950000
# DEEPL_RPM=60
# Edits re-translate only messages sent within this window (must be <= MESSAGE_MAP_RETENTION_H * 3600)
# EDIT_WINDOW_S=172800
# Media safety limits: decoded image pixels, decompressed TGS JSON size, per-item decode time budget (>= 5)
# MAX_IMAGE_PIXELS=25000000
# MAX_TGS_JSON_BYTES=4194304
# MEDIA_TIMEOUT_S=30
# Only for testing against a proxy/emulator
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Runtime ------------------------------------------------------------------------------------
# polling (default, no public URL needed) | webhook
RUN_MODE=polling
# WEBHOOK_URL=https://your.domain/webhook
# WEBHOOK_SECRET=a-long-random-string-of-[A-Za-z0-9_-]
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
# Polling mode health endpoint (/healthz: 503 when a worker died or the DB doesn't answer); Docker sets 8081
# HEALTH_PORT=8081
DATABASE_PATH=data/translator.sqlite3
MESSAGE_MAP_RETENTION_H=48
CACHE_TTL_DAYS=30
FAILURE_DIGEST_MINUTES=30
LOG_LEVEL=INFO
LOG_JSON=false
